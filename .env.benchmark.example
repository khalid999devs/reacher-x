# Copy to .env.benchmark.local and restrict access: chmod 600 .env.benchmark.local
# The benchmark CLI reads this file, with exported shell variables taking precedence.
# These are local inputs. Creating this file does not update Convex environment variables.

# Convex CLI login is also needed later. Use a dev deployment, never a prod key.
CONVEX_DEPLOYMENT=
BENCHMARK_USER_ID=

# Two distinct OpenRouter keys, each with its own approved limit.
# OPENROUTER_API_KEY must match the key installed on the dev deployment during a run.
OPENROUTER_API_KEY=
BENCHMARK_JUDGE_OPENROUTER_API_KEY=

# ReacherX data providers. Renidly is the current name for LinkdAPI.
# Use funded keys only during an approved live step.
SOCIALAPI_API_KEY=
LINKDAPI_API_KEY=
EXA_API_KEY=

# Competitors and independent evidence search.
# These entries may share a key. Count account-level spend once per actual account.
TREG_TOKEN=
TREG_TOKEN_REACHERX=
CLAY_API_KEY=
CONTEXT_DEV_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Optional. If absent, the existing embedding code uses OpenRouter.
OPENAI_API_KEY=
